<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.PlansView" x:Name="PlansRoot">
    <!-- Подписка v5 «Стекло» — как PlansView Windows-клиента. -->
    <UserControl.Styles>
        <Style Selector="ItemsControl.rows ContentPresenter:nth-child(1) Rectangle.sep">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.planRow"><Setter Property="Background" Value="Transparent"/></Style>
        <Style Selector="Grid.planRow.current"><Setter Property="Background" Value="{DynamicResource SelBgBrush}"/></Style>
        <Style Selector="Border.refStatus">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.refStatus.active">
            <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TealTintBrush}"/>
        </Style>
        <Style Selector="Border.refStatus TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
        <Style Selector="Border.refStatus.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource TealDeepBrush}"/></Style>
        <Style Selector="Border.refStatus Ellipse"><Setter Property="Fill" Value="Transparent"/></Style>
        <Style Selector="Border.refStatus.active Ellipse"><Setter Property="Fill" Value="{DynamicResource TealBrush}"/></Style>
        <Style Selector="Border.pagerBtn">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Карточка подписки (дизайн-ревью 1.0.132): строка «До …» контрастнее, при близком
             конце (≤ 7 дней) — warning-цвет. -->
        <Style Selector="TextBlock.expiry"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
        <Style Selector="TextBlock.expiry.soon"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
        <!-- Счётчик устройств в заголовке секции: лимит исчерпан — warning. -->
        <Style Selector="TextBlock.section.limit"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
        <!-- Плоская кнопка 52: моно капс, угол 2 -->
        <Style Selector="Button.cta">
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
    </UserControl.Styles>
    <!-- Без прокрутки: сверху шапка и карточка подписки, под ними переключатель разделов
         (устройства · друзья · новости); раздел занимает оставшееся место, длинные
         списки листаются страницами (PagedItems). -->
    <!-- Аккаунт — десктопный макет 9a: слева колонка 260 («N дней», срок, пояснение, полоса остатка, кнопка в
         кабинет), справа переключатель разделов и список (без прокрутки, постранично). -->
    <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,*" Margin="28,26,28,20">
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Margin="0,0,28,0">
            <TextBlock Text="{loc:T 'Аккаунт'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="{Binding DaysLabel}" FontWeight="SemiBold" FontSize="{s:Fs 52}" Foreground="{DynamicResource InkBrush}" Margin="0,22,0,0"/>
            <TextBlock FontSize="{s:Fs 14}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                <Run Text="{loc:T 'до '}"/><Run Text="{Binding ExpiryLabel}"/>
            </TextBlock>
            <TextBlock Text="{loc:T 'Подписка не продлевается сама — списаний врасплох не будет.'}" FontSize="{s:Fs 13}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <ProgressBar Minimum="0" Maximum="{Binding DaysTotal}" Value="{Binding DaysLeft}" Height="4" MinHeight="4" CornerRadius="0" Margin="0,18,0,0"
                         Foreground="{DynamicResource InkBtnBrush}" Background="{DynamicResource OutlineVariantBrush}"/>
            <Button Classes="cta" Margin="0,22,0,0" Command="{Binding OpenCabinetCommand}">
                <TextBlock Text="{loc:T 'ОПЛАТИТЬ В ЛИЧНОМ КАБИНЕТЕ'}" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 12}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button Classes="bare" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="0,14" AutomationProperties.Name="{loc:T 'Обновить подписку'}">
                <TextBlock Text="{loc:T 'ОБНОВИТЬ'}" FontFamily="{DynamicResource Mono}" FontSize="{s:Fs 11}" Foreground="{DynamicResource InkBrush}"/>
            </Button>
        </StackPanel>

        <c:SegmentedControl Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Sections}" DisplayMemberPath="Label"
                            SelectedIndex="{Binding SectionIndex, Mode=TwoWay}" ItemHeight="34" LabelFontSize="12" Margin="0,0,0,0"/>

        <Panel Grid.Column="1" Grid.Row="3" Margin="0,4,0,0">
            <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsDevicesSection}">
                <TextBlock Grid.Row="0" IsVisible="{Binding HasDevices}" Classes="section" Classes.limit="{Binding DevicesAtLimit}"
                           Text="{Binding DevicesSectionLabel}" Margin="8,14,8,0"/>
                <TextBlock Grid.Row="1" Classes="muted" Text="{loc:T 'Список устройств появится, когда подписка будет активна.'}" FontSize="{s:Fs 12.5}" Margin="8,16,8,0" IsVisible="{Binding !HasDevices}"/>
                <c:GlassPanel Grid.Row="1" Classes="card" Margin="0,8,0,0" VerticalAlignment="Top" IsVisible="{Binding HasDevices}">
                    <Panel>
                        <TextBlock Classes="muted" Text="{loc:T 'Нет подключённых устройств'}" Margin="14"
                                   IsVisible="{Binding Devices.Count, Converter={x:Static conv:Conv.IsZero}}"/>
                        <c:PagedItems ItemsSource="{Binding Devices}">
                            <c:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Rectangle Classes="hair pagedSep"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="14,13">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{s:Fs 13.5}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="{s:Fs 11}" Margin="0,2,0,0" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <c:Spinner Grid.Column="1" IsVisible="{Binding IsBusy}"/>
                                            <Button Grid.Column="1" Classes="bare" Padding="10,4" VerticalAlignment="Center" IsVisible="{Binding !IsBusy}"
                                                    AutomationProperties.Name="{loc:T 'Действия с устройством'}">
                                                <TextBlock Text="···" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 18}" Foreground="{DynamicResource InkBrush}"/>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="{loc:T 'Переименовать устройство'}" Command="{Binding #PlansRoot.DataContext.RenameDeviceCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{loc:T 'Удалить устройство'}" Command="{Binding #PlansRoot.DataContext.DeleteDeviceCommand}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </c:PagedItems.ItemTemplate>
                        </c:PagedItems>
                    </Panel>
                </c:GlassPanel>
                <Button Grid.Row="2" Classes="bare" HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding ShowTransferQrCommand}">
                    <c:GlassPanel Classes="card" CornerRadius="2" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="36" Height="36" CornerRadius="2" Background="{DynamicResource TealTintBrush}">
                                <Path Classes="icon teal" Data="{StaticResource IconQr}" Width="17" Height="17"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Перенести на другое устройство'}" FontWeight="Bold" FontSize="{s:Fs 13.5}"/>
                                <TextBlock Classes="rowSub" Text="{loc:T 'Покажи QR-код новому телефону — останется ввести код из письма'}"/>
                            </StackPanel>
                            <Path Grid.Column="2" Classes="icon secondary" Data="{StaticResource IconChevronRight}" Width="16" Height="16"/>
                        </Grid>
                    </c:GlassPanel>
                </Button>
            </Grid>

            <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsFriendsSection}">
                <TextBlock Grid.Row="0" Classes="section" Text="{loc:T 'ПРИГЛАСИ ДРУЗЕЙ'}" Margin="8,14,8,0" IsVisible="{Binding HasReferral}"/>
                <TextBlock Classes="muted" Text="{loc:T 'Программа приглашений пока недоступна.'}" FontSize="{s:Fs 12.5}" Margin="8,16,8,0" IsVisible="{Binding !HasReferral}"/>
                <c:GlassPanel Grid.Row="1" Classes="card" Padding="14" Margin="0,8,0,0" VerticalAlignment="Top" IsVisible="{Binding HasReferral}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                        <Border Height="44" Padding="14,0,6,0" CornerRadius="2" Background="{DynamicResource ChipBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="{Binding Referral.Link}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Classes="bare" Command="{Binding ShowReferralQrCommand}" VerticalAlignment="Center"
                                        Width="32" Height="32" Margin="0,0,6,0" ToolTip.Tip="QR-код ссылки">
                                    <Border CornerRadius="2" Background="{DynamicResource ThumbBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Path Classes="icon teal" Data="{StaticResource IconQr}" Width="15" Height="15"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="2" Classes="bare" Command="{Binding CopyReferralLinkCommand}" VerticalAlignment="Center">
                                    <Border Height="32" Padding="12,0" CornerRadius="2" Background="{DynamicResource AccentGradientBrush}">
                                        <TextBlock Text="{loc:T 'Копировать'}" FontWeight="Bold" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto,*" Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.TotalReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Classes="muted" Text="{loc:T 'Приглашено'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Classes="vhair"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.ActiveReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Classes="muted" Text="{loc:T 'Активных'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Classes="vhair"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock FontWeight="Bold" FontSize="{s:Fs 20}" Foreground="{DynamicResource TealDeepBrush}" HorizontalAlignment="Center"
                                           Text="{Binding Referral.TotalBonusDays, StringFormat='+{0}'}"/>
                                <TextBlock Classes="muted" Text="{loc:T 'Бонус дней'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="2" Classes="hair" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="3" Classes="muted" Text="{loc:T 'У вас пока нет приглашённых пользователей'}" Margin="0,7" IsVisible="{Binding !Referral.HasEntries}"/>
                        <c:PagedItems Grid.Row="4" ItemsSource="{Binding Referral.Entries}">
                            <c:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,7">
                                        <Border Width="28" Height="28" CornerRadius="2" Background="{DynamicResource ChipBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BonusLabel}" FontWeight="Bold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TealDeepBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding HasBonusLabel}"/>
                                        <Border Grid.Column="3" Classes="refStatus" Classes.active="{Binding IsActive}" Height="22" CornerRadius="2"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="7,0,9,0" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="ExtraBold" FontSize="{s:Fs 10}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </c:PagedItems.ItemTemplate>
                        </c:PagedItems>
                    </Grid>
                </c:GlassPanel>
            </Grid>

            <Grid RowDefinitions="*" IsVisible="{Binding IsNewsSection}">
                <TextBlock Classes="muted" Text="{loc:T 'Новостей пока нет.'}" FontSize="{s:Fs 12.5}" Margin="8,10,8,0" IsVisible="{Binding !HasNews}"/>
                <c:PagedItems ItemsSource="{Binding AllNews}">
                    <c:PagedItems.ItemTemplate>
                        <DataTemplate>
                            <!-- Компактные строки (1.0.132): поля и отступы теснее; листание «Ещё» — прежний PagedItems. -->
                            <c:GlassPanel Classes="card" CornerRadius="2" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Classes="muted" Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}"/>
                                    <SelectableTextBlock Text="{Binding Text}" FontSize="{s:Fs 12.5}" LineHeight="{s:Fs 17}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Classes="link" HorizontalAlignment="Left" Padding="0,4,0,0" FontSize="{s:Fs 12}" FontWeight="Bold"
                                            Content="{loc:T 'Читать полностью'}" Command="{Binding ExpandCommand}" IsVisible="{Binding CanExpand}"/>
                                    <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,6,0,0"
                                                  IsVisible="{Binding Buttons.Count, Converter={x:Static conv:Conv.NonZero}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="chip" Height="28" Margin="0,0,6,4" Content="{Binding Text}"
                                                        Command="{Binding $parent[UserControl].DataContext.OpenBroadcastButtonCommand}" CommandParameter="{Binding Url}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </c:GlassPanel>
                        </DataTemplate>
                    </c:PagedItems.ItemTemplate>
                </c:PagedItems>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
