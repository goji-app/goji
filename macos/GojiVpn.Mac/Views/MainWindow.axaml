<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GodjiVpn.Views.MainWindow"
        Title="Goji VPN" Width="920" Height="580" CanResize="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgSolidBrush}">
    <!-- Макет 9a: окно фиксированного размера 920×580. Какой экран показан (знакомство, вход, оболочка
         с левой навигацией), решают DataTemplates в App.axaml по типу CurrentViewModel. -->
    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
