<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.LoginView">
    <!-- Вход — макет 9a: «Войти по почте», поле с нижней линией, кнопка «ПОЛУЧИТЬ КОД»; следующий шаг —
         «Код из письма» (6 клеток). Без глобуса; колонка 420 по центру окна. -->
    <UserControl.Styles>
        <!-- Поле только с нижней линией (макет 9a «Вход») -->
        <Style Selector="TextBox.line">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBox.line:pointerover /template/ Border#PART_BorderElement, TextBox.line:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Плоская кнопка 56: моно капс, угол 2 -->
        <Style Selector="Button.cta">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Button.cta:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Panel Background="{DynamicResource BgSolidBrush}">
        <!-- Шаг 1: почта -->
        <StackPanel Width="420" VerticalAlignment="Center" IsVisible="{Binding !OtpSent}">
            <loc:LangPicker Margin="0,0,0,18"/>
            <!-- Зимой — шапка Деда Мороза на «В» заголовка (вне сезона элемент схлопывается) -->
            <loc:SantaHat HorizontalAlignment="Left" Margin="2,0,0,0"/>
            <TextBlock Text="{loc:T 'Войти по почте'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="{loc:T 'Пришлём код из шести цифр. Пароль не нужен. Первые 3 дня бесплатно.'}" FontSize="{s:Fs 15}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="{loc:T 'ПОЧТА'}" FontFamily="{DynamicResource Mono}" FontSize="{s:Fs 11}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,30,0,8"/>
            <TextBox Name="EmailBox" Classes="line" Text="{Binding Email}" AutomationProperties.Name="{loc:T 'Почта'}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{s:Fs 12}" TextWrapping="Wrap" Margin="0,10,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Button Classes="cta" Margin="0,28,0,0" Content="{loc:T 'ПОЛУЧИТЬ КОД'}" Command="{Binding SendOtpCommand}"/>
            <TextBlock TextWrapping="Wrap" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,0">
                <Run Text="{loc:T 'Аккаунта нет? Создадим сами, ничего заполнять не нужно. Создавая аккаунт, вы соглашаетесь с пользовательским соглашением и политикой конфиденциальности.'}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                <Button Classes="bare" Command="{Binding OpenTermsCommand}" Padding="0,4">
                    <TextBlock Text="{loc:T 'Соглашение'}" FontWeight="SemiBold" FontSize="{s:Fs 12}" Foreground="{DynamicResource InkBrush}" TextDecorations="Underline"/>
                </Button>
                <Button Classes="bare" Command="{Binding OpenPrivacyCommand}" Padding="0,4">
                    <TextBlock Text="{loc:T 'Политика конфиденциальности'}" FontWeight="SemiBold" FontSize="{s:Fs 12}" Foreground="{DynamicResource InkBrush}" TextDecorations="Underline"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Шаг 2: код из письма -->
        <StackPanel Width="420" VerticalAlignment="Center" IsVisible="{Binding OtpSent}">
            <StackPanel IsVisible="{Binding !IsVerifySuccess}">
                <Button Classes="bare" Command="{Binding ChangeEmailCommand}" HorizontalAlignment="Left" Padding="0,6,12,6" AutomationProperties.Name="{loc:T 'Назад'}">
                    <TextBlock Text="‹ ПОЧТА" FontFamily="{DynamicResource Mono}" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{loc:T 'Код из письма'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}" Margin="0,14,0,0"/>
                <TextBlock FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="{loc:T 'Отправили на '}"/><Run Text="{Binding Email}"/><Run Text="{loc:T '. Письмо идёт до минуты — загляни в «Спам».'}"/>
                </TextBlock>
                <c:OtpInput Name="Otp" Code="{Binding Code}" Margin="-4,30,-4,0"
                            HasError="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock FontFamily="{DynamicResource Mono}" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0"
                           Text="{Binding VerifyHint}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{s:Fs 12}" TextWrapping="Wrap" Margin="0,8,0,0"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Classes="cta" Margin="0,24,0,0" Content="{loc:T 'ВОЙТИ'}" Command="{Binding VerifyCommand}"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsVerifySuccess}">
                <TextBlock Text="{loc:T 'Готово'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="{loc:T 'Почта подтверждена'}" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
