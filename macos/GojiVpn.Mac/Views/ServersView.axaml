<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.ServersView">
    <!-- Серверы v5 «Стекло»: заголовок, "Обновить"/"Пинг", сортировка, баннер результата,
         все узлы — одна стеклянная карточка со строками через разделитель. -->
    <UserControl.Styles>
        <Style Selector="Border.rbanner"><Setter Property="Background" Value="{DynamicResource BannerOkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Style>
        <Style Selector="Border.rbanner.error"><Setter Property="Background" Value="{DynamicResource ErrorContainerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></Style>
        <Style Selector="Border.cell"><Setter Property="Background" Value="Transparent"/></Style>
        <Style Selector="Border.cell.selected"><Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/></Style>
        <Style Selector="Grid.nodeRow.selected"><Setter Property="Background" Value="{DynamicResource SelBgBrush}"/></Style>
        <Style Selector="Border.flag"><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/></Style>
        <Style Selector="Border.flag.selected"><Setter Property="BorderBrush" Value="{DynamicResource TealBrush}"/></Style>
        <Style Selector="Path.star">
            <Setter Property="Data" Value="{StaticResource IconStarOutline}"/>
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Path.star.on">
            <Setter Property="Data" Value="{StaticResource IconStar}"/>
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="TextBlock.ping"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
        <!-- Зелёный порог — по шкале Primary (значения порогов не менялись: <500 good, <1000 mid). -->
        <Style Selector="TextBlock.ping.good"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></Style>
        <Style Selector="TextBlock.ping.mid"><Setter Property="Foreground" Value="#C98B12"/></Style>
        <Style Selector="TextBlock.ping.bad"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
        <Style Selector="c|GlassPanel.banner"><Setter Property="Tint" Value="{DynamicResource BannerOkBrush}"/></Style>
        <Style Selector="c|GlassPanel.banner.error"><Setter Property="Tint" Value="{DynamicResource BannerWarnBrush}"/></Style>
        <Style Selector="Ellipse.bannerDot"><Setter Property="Fill" Value="{DynamicResource TealBrush}"/></Style>
        <Style Selector="Ellipse.bannerDot.error"><Setter Property="Fill" Value="{DynamicResource TerracottaBrush}"/></Style>
        <Style Selector="Path.bannerIcon"><Setter Property="Data" Value="{StaticResource IconCheck}"/></Style>
        <Style Selector="Path.bannerIcon.error"><Setter Property="Data" Value="{StaticResource IconPriorityHigh}"/></Style>
    </UserControl.Styles>
    <!-- Без прокрутки: список узлов занимает оставшееся место и листается страницами. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Classes="title" Text="{loc:T 'Где выйти в сеть'}" TextWrapping="Wrap"/>
                    <TextBlock Classes="muted" Margin="0,3,0,0" Text="{Binding Nodes.Count, StringFormat='{}{0} узлов в подписке'}"/>
                </StackPanel>
                <!-- Две кнопки, у каждой свой индикатор (2026-10-28): с одной общей он крутился и во
                     время автоматической проверки пинга — выглядело как «постоянное обновление». -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Classes="bare" Command="{Binding PingAllCommand}" AutomationProperties.Name="{loc:T 'Проверить пинг всех серверов'}">
                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="2" Height="40" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Classes="icon teal" Data="{StaticResource IconBolt}" Width="16" Height="16" IsVisible="{Binding !IsCheckingAll}"/>
                                    <c:Spinner Foreground="{DynamicResource TealDeepBrush}" IsVisible="{Binding IsCheckingAll}"/>
                                </Panel>
                                <TextBlock Text="{loc:T 'Пинг'}" FontWeight="Bold" FontSize="{s:Fs 13}" Foreground="{DynamicResource TealDeepBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Classes="bare" Command="{Binding RefreshCommand}" AutomationProperties.Name="{loc:T 'Обновить список серверов'}">
                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="2" Height="40" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Classes="icon teal" Data="{StaticResource IconRefresh}" Width="16" Height="16" IsVisible="{Binding !IsRefreshing}"/>
                                    <c:Spinner Foreground="{DynamicResource TealDeepBrush}" IsVisible="{Binding IsRefreshing}"/>
                                </Panel>
                                <TextBlock Text="{loc:T 'Обновить'}" FontWeight="Bold" FontSize="{s:Fs 13}" Foreground="{DynamicResource TealDeepBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>

            <c:SegmentedControl Grid.Row="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" ItemHeight="32" LabelFontSize="12" Margin="0,12,0,0"/>

            <Border Grid.Row="2" Classes="rbanner" Classes.error="{Binding RefreshResultIsError}" Margin="0,12,0,0" Padding="14,10,8,10" BorderThickness="4,0,0,0"
                    IsVisible="{Binding RefreshResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RefreshResultMessage}" FontWeight="SemiBold" FontSize="{s:Fs 13}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" Classes="bare" Command="{Binding DismissRefreshResultCommand}" VerticalAlignment="Center" Padding="8,6" AutomationProperties.Name="{loc:T 'Закрыть'}">
                        <TextBlock Text="×" FontWeight="Bold" FontSize="{s:Fs 16}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <c:PagedItems Grid.Row="3" Columns="2" Margin="0,12,0,0" VerticalAlignment="Top" ItemsSource="{Binding Nodes}">
                <c:PagedItems.ItemTemplate>
                    <DataTemplate>
                        <!-- Ячейка макета 9a: код страны 34 моно, название, шкала пинга; выбранная — «шалфей». -->
                        <Border Classes="cell" Classes.selected="{Binding IsSelected}" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource OutlineVariantBrush}" Margin="0,0,12,0">
                            <Grid>
                                <Button Classes="bare" HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectCommand}" CommandParameter="{Binding}">
                                    <Grid Margin="14,12,44,12" ColumnDefinitions="86,*">
                                        <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 34}"
                                                   Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{s:Fs 15}" Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <c:PingBar Width="56" BarHeight="4" PingMs="{Binding PingBarMs}" MarkerBrush="{DynamicResource InkBrush}"/>
                                                <TextBlock Text="{Binding PingNumber}" FontFamily="{DynamicResource Mono}" FontWeight="SemiBold" FontSize="{s:Fs 12}"
                                                           Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,4,2,0">
                                    <Button Classes="bare" Padding="6" AutomationProperties.Name="{loc:T 'Проверить пинг'}"
                                            Command="{Binding $parent[ItemsControl].DataContext.PingOneCommand}" CommandParameter="{Binding}">
                                        <Path Classes="icon" Data="{StaticResource IconBolt}" Width="13" Height="13"/>
                                    </Button>
                                    <Button Classes="bare" Padding="6" AutomationProperties.Name="{loc:T 'Избранное'}"
                                            Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}">
                                        <Path Classes="icon star" Classes.on="{Binding IsFavorite}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                                <!-- Узел, добавленный вручную по JSON — только у таких есть удаление. -->
                                <Button Classes="bare" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,4" IsVisible="{Binding IsCustom}"
                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCustomNodeCommand}" CommandParameter="{Binding}">
                                    <Path Classes="icon danger" Data="{StaticResource IconDelete}" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </c:PagedItems.ItemTemplate>
            </c:PagedItems>
    </Grid>
</UserControl>
