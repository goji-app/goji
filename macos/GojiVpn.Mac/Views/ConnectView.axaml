<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.ConnectView">
    <!-- Главная — десктопный макет 9a: слева панель с заливкой по состоянию (метка, код страны, заголовок,
         подзаголовок), справа колонка 320 с таблицей и кнопкой ‹ ОТКЛЮЧИТЬ ›. Кисти Home* code-behind
         подменяет по состоянию, Border плавно перекрашивается за 500 мс. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="HomeFillBrush" Color="#F4F5F2"/>
        <SolidColorBrush x:Key="HomeInkBrush" Color="#2A3430"/>
        <SolidColorBrush x:Key="HomeMutBrush" Color="#5F6A65"/>
        <SolidColorBrush x:Key="HomeBtnBrush" Color="#4F6358"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.mono.value"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
        <Style Selector="Border.trow">
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
        <Style Selector="c|CountryCodeText.on">
            <Setter Property="Fill" Value="{DynamicResource HomeInkBrush}"/>
            <Setter Property="Stroke" Value="{x:Null}"/>
        </Style>
        <!-- Плоская кнопка: угол 2, моно капс. -->
        <Style Selector="Button.flat">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource HomeBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeBtnBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <!-- Стрелки ‹ › 56×56 с рамкой. -->
        <Style Selector="Button.arrow">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style Selector="Button.arrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
        </Style>
        <!-- Кнопки действий в блоке ошибки -->
        <Style Selector="Button.err">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.err:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,320">
        <!-- Левая панель с заливкой состояния -->
        <Border Grid.Column="0" Background="{DynamicResource HomeFillBrush}">
            <Border.Transitions>
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.5"/></Transitions>
            </Border.Transitions>
            <StackPanel Margin="28,26,28,0">
                <Grid>
                    <TextBlock FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="{DynamicResource HomeMutBrush}" HorizontalAlignment="Left" Text="{Binding StateTag}"/>
                    <TextBlock FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="{DynamicResource HomeMutBrush}" HorizontalAlignment="Right" Text="{Binding ServerCounter}"/>
                </Grid>

                <!-- Код страны 170: контур в выключенном состоянии, заливка — при подключении и в сети. Тап — следующая страна. -->
                <c:CountryCodeText Margin="-6,10,0,0" Text="{Binding CountryCode}" MaxFontSize="170" Cursor="Hand"
                                   Classes.on="{Binding IsOnOrBusy}" Stroke="{DynamicResource OutlineVariantBrush}"
                                   ToolTip.Tip="Следующая страна" AutomationProperties.Name="{Binding CountryCode}"
                                   PointerPressed="OnCodePressed"/>

                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="{s:Fs 32}" Foreground="{DynamicResource HomeInkBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding Subline}" FontSize="{s:Fs 15}" Foreground="{DynamicResource HomeMutBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- Ошибка подключения: заметный блок — красная полоса слева, подложка ошибки, кнопки действий -->
                <Border Margin="0,18,0,0" Padding="14,12,14,14" BorderThickness="4,0,0,0" BorderBrush="{DynamicResource DangerBrush}"
                        Background="{DynamicResource ErrorContainerBrush}"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'ОШИБКА'}" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 11}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorHint}" FontWeight="Bold" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="{s:Fs 13}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Classes="err" Content="{loc:T 'ПОВТОРИТЬ'}" Command="{Binding RetryRefreshCommand}" IsVisible="{Binding CanRetryRefresh}"/>
                            <Button Classes="err" Content="{loc:T 'СМЕНИТЬ СЕРВЕР'}" Command="{Binding OpenServersCommand}" IsVisible="{Binding CanChangeServer}"/>
                            <Button Classes="err" Content="{loc:T 'ОТКРЫТЬ ПОДПИСКУ'}" Command="{Binding OpenTrafficCommand}" IsVisible="{Binding CanOpenPlans}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Пробный период — включается прямо в приложении -->
                <StackPanel Margin="0,14,0,0" IsVisible="{Binding HasTrial}">
                    <TextBlock Text="{Binding TrialTitle}" FontWeight="SemiBold" FontSize="{s:Fs 15}" Foreground="{DynamicResource HomeInkBrush}" TextWrapping="Wrap"/>
                    <Button Classes="flat" Content="{loc:T 'ВКЛЮЧИТЬ ПРОБНЫЙ ПЕРИОД'}" Command="{Binding ActivateTrialCommand}" Height="40" HorizontalAlignment="Left"
                            Padding="16,0" Margin="0,8,0,0" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 12}"/>
                </StackPanel>
                <TextBlock Text="{Binding TrialNotice}" FontSize="{s:Fs 12}" Foreground="{DynamicResource HomeMutBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           IsVisible="{Binding TrialNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- Правая колонка 320: таблица и управление -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Background="{DynamicResource BgSolidBrush}">
            <StackPanel Grid.Row="0" Margin="28,26,28,0">
                <Border Classes="trow">
                    <Grid ColumnDefinitions="92,*">
                        <TextBlock Classes="mono" Text="{loc:T 'УЗЕЛ'}"/>
<TextBlock Grid.Column="1" Classes="mono value" Text="{Binding NodeCity}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Border Classes="trow">
                    <Grid ColumnDefinitions="92,*">
                        <TextBlock Classes="mono" Text="{loc:T 'В СЕТИ'}"/>
<Panel Grid.Column="1">
                            <TextBlock Classes="mono value" IsVisible="{Binding IsConnected}" Text="{Binding ConnectedTimeLabel}"/>
                            <TextBlock Classes="mono value" IsVisible="{Binding !IsConnected}" Text="—"/>
                        </Panel>
                    </Grid>
                </Border>
                <Border Classes="trow">
                    <Grid ColumnDefinitions="92,*">
                        <TextBlock Classes="mono" Text="{loc:T 'ПОДПИСКА'}"/>
<TextBlock Grid.Column="1" Classes="mono value" Text="{Binding SubDaysLabel}"/>
                    </Grid>
                </Border>
                <Border Classes="trow" BorderThickness="0,1,0,1">
                    <Grid ColumnDefinitions="92,Auto,*">
                        <TextBlock Classes="mono" Text="{loc:T 'ПИНГ'}"/>
                        <c:PingBar Grid.Column="1" Width="80" PingMs="{Binding PingMs}" MarkerBrush="{DynamicResource InkBrush}"/>
                        <TextBlock Grid.Column="2" Classes="mono value" Text="{Binding PingText}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
                <Border Classes="trow" BorderThickness="0">
                    <Grid ColumnDefinitions="92,*">
                        <TextBlock Classes="mono" Text="{loc:T 'СКОРОСТЬ'}"/>
<Panel Grid.Column="1">
                            <TextBlock Classes="mono value" IsVisible="{Binding IsConnected}">
                                <Run Text="↓ "/><Run Text="{Binding DownSpeedLabel}"/><Run Text="  ↑ "/><Run Text="{Binding UpSpeedLabel}"/><Run Text="{loc:T ' МБ/с'}"/>
                            </TextBlock>
                            <TextBlock Classes="mono value" IsVisible="{Binding !IsConnected}" Text="—"/>
                        </Panel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ‹ ОТКЛЮЧИТЬ › — смена страны стрелками, кнопка посередине -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="28,0,28,28">
                <Button Grid.Column="0" Classes="arrow" Content="‹" Command="{Binding PrevServerCommand}" AutomationProperties.Name="{loc:T 'Предыдущая страна'}"/>
                <Button Grid.Column="1" Classes="flat" Margin="8,0" Command="{Binding ToggleCommand}" ToolTip.Tip="⌘⇧G" AutomationProperties.Name="{loc:T 'Подключение'}"
                        Content="{Binding ToggleLabel}" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="{s:Fs 14}"/>
                <Button Grid.Column="2" Classes="arrow" Content="›" Command="{Binding NextServerCommand}" AutomationProperties.Name="{loc:T 'Следующая страна'}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
