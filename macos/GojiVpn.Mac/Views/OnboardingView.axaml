<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             x:Class="GodjiVpn.Views.OnboardingView">
    <!-- Знакомство — макет 9a: «Пропустить», панель «шалфей» с огромным кодом, заголовок, текст, три сегмента и кнопка. -->
    <UserControl.Styles>
        <!-- Поле только с нижней линией (макет 9a «Вход») -->
        <Style Selector="TextBox.line">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBox.line:pointerover /template/ Border#PART_BorderElement, TextBox.line:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Плоская кнопка 56: моно капс, угол 2 -->
        <Style Selector="Button.cta">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Button.cta:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Panel Background="{DynamicResource BgSolidBrush}">
        <StackPanel Width="460" VerticalAlignment="Center">
            <Button Classes="bare" Command="{Binding SkipCommand}" HorizontalAlignment="Right" Padding="0,8" IsVisible="{Binding !IsLast}">
                <TextBlock Text="{loc:T 'Пропустить'}" FontSize="{s:Fs 14}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
            <Border Height="180" Background="{DynamicResource SecondaryContainerBrush}" Margin="0,6,0,0">
                <StackPanel VerticalAlignment="Center">
                    <c:CountryCodeText Text="{Binding Code}" MaxFontSize="100" Centered="True" Fill="{DynamicResource OnSecondaryContainerBrush}"/>
                    <TextBlock Text="{Binding CodeCaption}" FontFamily="{DynamicResource Mono}" FontSize="{s:Fs 11}" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource OnSecondaryContainerBrush}" Margin="16,12,16,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" FontSize="{s:Fs 30}" TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}" Margin="0,22,0,0"/>
            <ItemsControl ItemsSource="{Binding Current.Points}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Dots}" Margin="0,22,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="seg" Classes.on="{Binding}" Height="2" Margin="0,0,6,0" Background="{DynamicResource OutlineVariantBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="cta" Margin="0,16,0,0" Content="{Binding NextLabelUpper}" Command="{Binding NextCommand}"/>
        </StackPanel>
    </Panel>
</UserControl>
