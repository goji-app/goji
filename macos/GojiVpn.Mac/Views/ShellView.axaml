<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GodjiVpn.Controls"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.ShellView">
    <UserControl.Styles>
        <!-- Пункт левой навигации макета 9a: «01 ГЛАВНАЯ», моно 12; активный — рамка слева 3 и фон surface. -->
        <Style Selector="Button.nav">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="22,0,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="188,*" Background="{DynamicResource BgSolidBrush}">
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource OutlineVariantBrush}">
            <StackPanel Margin="0,28,0,0">
                <TextBlock Text="GOJI" FontFamily="{DynamicResource Mono}" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}" Margin="25,0,0,26"/>
                <Button Classes="nav" Tag="0" Click="OnTabClick" Content="{loc:T '01 ГЛАВНАЯ'}"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=0}"/>
                <Button Classes="nav" Tag="1" Click="OnTabClick" Content="{loc:T '02 СЕРВЕРЫ'}"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=1}"/>
                <Button Classes="nav" Tag="2" Click="OnTabClick" Content="{loc:T '03 АККАУНТ'}"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=2}"/>
                <Button Classes="nav" Tag="3" Click="OnTabClick" Content="{loc:T '04 НАСТРОЙКИ'}"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=3}"/>
            </StackPanel>
        </Border>
        <!-- Содержимое: без прокрутки, длинные списки — постранично -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding Connect}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=0}"/>
            <ContentControl Content="{Binding Servers}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=1}"/>
            <ContentControl Content="{Binding Plans}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=2}"/>
            <ContentControl Content="{Binding Settings}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=3}"/>
        </Panel>
    </Grid>
</UserControl>
