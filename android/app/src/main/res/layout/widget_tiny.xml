<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 1×1: кнопка питания. Цвета — из выбранной палитры (см. WidgetState). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wt_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_card"
        android:tint="@color/widget_button_teal" />
    <ImageView
        android:id="@+id/wt_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:src="@drawable/wg_power"
        android:tint="@color/widget_button_text" />
</FrameLayout>
