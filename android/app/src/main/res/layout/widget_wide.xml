<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 4×2: страна, сервер, подписка, смена сервера и кнопка. Цвета — из палитры (см. WidgetState). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wd_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_card"
        android:tint="@color/widget_bg" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/wd_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/wg_oval"
                    android:tint="@color/widget_dot_muted" />
                <TextView
                    android:id="@+id/wd_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="Не защищено"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/wd_code"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="DE"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/wd_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Франкфурт"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/wd_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="24 дня · до 12.12"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <ImageView android:id="@+id/wd_bar0" android:layout_width="16dp" android:layout_height="5dp" android:src="@drawable/wg_bar" android:tint="@color/widget_bar_on" />
                <ImageView android:id="@+id/wd_bar1" android:layout_width="16dp" android:layout_height="5dp" android:layout_marginStart="3dp" android:src="@drawable/wg_bar" android:tint="@color/widget_bar_on" />
                <ImageView android:id="@+id/wd_bar2" android:layout_width="16dp" android:layout_height="5dp" android:layout_marginStart="3dp" android:src="@drawable/wg_bar" android:tint="@color/widget_bar_on" />
                <ImageView android:id="@+id/wd_bar3" android:layout_width="16dp" android:layout_height="5dp" android:layout_marginStart="3dp" android:src="@drawable/wg_bar" android:tint="@color/widget_bar_off" />
                <ImageView android:id="@+id/wd_bar4" android:layout_width="16dp" android:layout_height="5dp" android:layout_marginStart="3dp" android:src="@drawable/wg_bar" android:tint="@color/widget_bar_off" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/wd_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                    <ImageView
                        android:id="@+id/wd_prev_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/wg_oval"
                        android:tint="@color/widget_node_bg" />
                    <TextView
                        android:id="@+id/wd_prev_t"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="22sp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/wd_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                    <ImageView
                        android:id="@+id/wd_next_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/wg_oval"
                        android:tint="@color/widget_node_bg" />
                    <TextView
                        android:id="@+id/wd_next_t"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="22sp" />
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/wd_button_box"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/wd_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/wg_pill"
                    android:tint="@color/widget_button_teal" />
                <TextView
                    android:id="@+id/wd_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Подключить"
                    android:textColor="@color/widget_button_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
