<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2×2: статус, сервер, кнопка. Цвета — из выбранной палитры (см. WidgetState). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ws_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_card"
        android:tint="@color/widget_bg" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ws_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/wg_oval"
                android:tint="@color/widget_dot_muted" />
            <TextView
                android:id="@+id/ws_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Goji"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/ws_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Не защищено"
            android:textColor="@color/widget_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ws_node"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Германия"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <FrameLayout
            android:id="@+id/ws_button_box"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/ws_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/wg_pill"
                android:tint="@color/widget_button_teal" />
            <TextView
                android:id="@+id/ws_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Подключить"
                android:textColor="@color/widget_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
