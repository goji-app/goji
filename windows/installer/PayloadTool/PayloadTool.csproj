<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GodjiPayloadTool</RootNamespace>
    <!-- SelfContained=false: инструмент запускается только на машине сборки, где SDK есть. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- LZMA-кодек для payload.bin: тот же профиль, что у прежнего Inno (lzma2/max) —
         ~330 МБ publish → ~90 МБ. BrotliStream из .NET не годится (окно не настраивается,
         ratio почти вдвое хуже). Декодер того же пакета лежит в Setup. -->
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
  </ItemGroup>

</Project>
