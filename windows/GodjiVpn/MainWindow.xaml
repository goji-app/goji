<Window x:Class="GodjiVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Goji VPN" Width="936" Height="619"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgSolidBrush}"
        Icon="pack://application:,,,/Assets/Images/logo.png"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- Макет 9a: окно фиксированного размера (клиентская область 920×580), системная рамка и кнопки.
         Какой экран показан (знакомство, вход, оболочка с левой навигацией), решают DataTemplate'ы в App.xaml. -->
    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
