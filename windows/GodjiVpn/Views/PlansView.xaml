<UserControl x:Class="GodjiVpn.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls"
             xmlns:utils="clr-namespace:GodjiVpn.Utils">
    <!-- Подписка v5 «Стекло» — по эталону screens/*-plans.png и PlansScreen.kt (разметка
         handoff-1.0.77/reference/GojiGlassFull.dc.html, isPlans): колонка padding 16, gap 12. -->
    <!-- Без прокрутки: сверху шапка и карточка подписки, под ними переключатель разделов
         (устройства · друзья · новости); раздел занимает оставшееся место, длинные
         списки листаются страницами (PagedItems). -->
    <UserControl.Resources>
        <!-- Плоская кнопка: угол 2, моно капс, перенос длинной подписи -->
        <Style x:Key="FlatCta" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{s:Fs 12}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" Background="{TemplateBinding Background}" Padding="10,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.92"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Аккаунт — десктопный макет 9a: слева колонка 260 («N дней», срок, пояснение, полоса остатка, кнопка в
         кабинет), справа переключатель разделов и список (без прокрутки, постранично). -->
    <Grid Margin="28,26,28,20" Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Margin="0,0,28,0">
            <TextBlock Text="{loc:T 'Аккаунт'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="{Binding DaysLabel}" FontWeight="SemiBold" FontSize="{s:Fs 52}" Foreground="{DynamicResource InkBrush}" Margin="0,22,0,0"/>
            <TextBlock FontSize="{s:Fs 14}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                <Run Text="{loc:T 'до '}"/><Run Text="{Binding ExpiryLabel, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{loc:T 'Подписка не продлевается сама — списаний врасплох не будет.'}" FontSize="{s:Fs 13}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Grid Height="4" Margin="0,18,0,0">
                <Border Background="{DynamicResource OutlineVariantBrush}"/>
                <ProgressBar Minimum="0" Maximum="{Binding DaysTotal}" Value="{Binding DaysLeft, Mode=OneWay}" Height="4" BorderThickness="0"
                             Foreground="{DynamicResource InkBtnBrush}" Background="Transparent"/>
            </Grid>
            <Button Style="{StaticResource FlatCta}" Margin="0,22,0,0" Content="{loc:T 'ОПЛАТИТЬ В ЛИЧНОМ КАБИНЕТЕ'}" Command="{Binding OpenCabinetCommand}"/>
            <Button Style="{StaticResource BareButton}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="0,14" AutomationProperties.Name="{loc:T 'Обновить подписку'}">
                <TextBlock Text="{loc:T 'ОБНОВИТЬ'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 11}" Foreground="{DynamicResource InkBrush}"/>
            </Button>
        </StackPanel>

        <controls:SegmentedControl Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Sections}" DisplayMemberPath="Label"
                                   SelectedIndex="{Binding SectionIndex, Mode=TwoWay}" ItemHeight="34" LabelFontSize="12" Margin="0,0,0,0"/>

        <Grid Grid.Column="1" Grid.Row="3" Margin="0,4,0,0">
            <Grid Visibility="{Binding IsDevicesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Лимит устройств исчерпан — счётчик секции подсвечен warning (1.0.132). -->
                <TextBlock Grid.Row="0" Text="{Binding DevicesSectionLabel}" Margin="8,14,8,0"
                           Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceLimitReached}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="{loc:T 'Список устройств появится, когда подписка будет активна.'}" FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <controls:GlassPanel Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,8,0,0" VerticalAlignment="Top"
                                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <TextBlock Text="{loc:T 'Нет подключённых устройств'}" FontWeight="Medium" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="14" Visibility="{Binding Devices.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}"/>
                        <controls:PagedItems ItemsSource="{Binding Devices}">
                            <controls:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Rectangle Style="{StaticResource PagedSep}"/>
                                        <Grid Margin="14,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{s:Fs 13.5}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontWeight="Medium" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <controls:Spinner Grid.Column="1" Foreground="{DynamicResource TealBrush}"
                                                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BareButton}" Padding="10,4" VerticalAlignment="Center"
                                                    Click="DeviceMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    AutomationProperties.Name="{loc:T 'Действия с устройством'}"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="···" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 18}" Foreground="{DynamicResource InkBrush}"/>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:T 'Переименовать устройство'}"
                                                                  Command="{Binding PlacementTarget.Tag.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{loc:T 'Удалить устройство'}"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:PagedItems.ItemTemplate>
                        </controls:PagedItems>
                    </Grid>
                </controls:GlassPanel>
                <!-- Перенос входа на другое устройство по QR: в коде почта, дальше код из письма. -->
                <Button Grid.Row="2" Style="{StaticResource BareButton}" controls:Press.Scale="0.98" Margin="0,12,0,0" Command="{Binding ShowTransferQrCommand}"
                        AutomationProperties.Name="{loc:T 'Перенести на другое устройство'}">
                    <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="2" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="2" Background="{DynamicResource TealTintBrush}">
                                <Path Data="{StaticResource IconQr}" Style="{StaticResource Icon}" Width="17" Height="17" Fill="{DynamicResource TealDeepBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Перенести на другое устройство'}" FontWeight="Bold" FontSize="{s:Fs 13.5}"/>
                                <TextBlock Text="{loc:T 'Покажи QR-код новому телефону — останется ввести код из письма'}" FontWeight="Medium" FontSize="{s:Fs 11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="{s:Fs 15.4}"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}" Width="16" Height="16"
                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </controls:GlassPanel>
                </Button>
            </Grid>

            <Grid Visibility="{Binding IsFriendsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{loc:T 'ПРИГЛАСИ ДРУЗЕЙ'}" Style="{StaticResource SectionLabel}" Margin="8,14,8,0"
                           Visibility="{Binding HasReferral, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{loc:T 'Программа приглашений пока недоступна.'}" FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasReferral, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <controls:GlassPanel Grid.Row="1" Visibility="{Binding HasReferral, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource GlassCard}" Padding="14" Margin="0,8,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:PillBorder Height="44" Padding="14,0,6,0" Background="{DynamicResource ChipBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Referral.Link}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <!-- QR ссылки: друг сканирует камерой прямо с экрана (порт 79b3e4b). -->
                                <Button Grid.Column="1" Style="{StaticResource BareButton}" Command="{Binding ShowReferralQrCommand}" VerticalAlignment="Center"
                                        Width="32" Height="32" Margin="0,0,6,0" ToolTip="{loc:T 'QR-код ссылки'}" AutomationProperties.Name="{loc:T 'QR-код ссылки'}">
                                    <Border CornerRadius="2" Background="{DynamicResource ThumbBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Path Data="{StaticResource IconQr}" Style="{StaticResource Icon}" Width="15" Height="15" Fill="{DynamicResource TealDeepBrush}"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource BareButton}" Command="{Binding CopyReferralLinkCommand}" VerticalAlignment="Center">
                                    <controls:PillBorder Height="32" Padding="12,0" Background="{DynamicResource AccentGradientBrush}">
                                        <TextBlock Text="{loc:T 'Копировать'}" FontWeight="Bold" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"/>
                                    </controls:PillBorder>
                                </Button>
                            </Grid>
                        </controls:PillBorder>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.TotalReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T 'Приглашено'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Style="{StaticResource VHair}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.ActiveReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T 'Активных'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Style="{StaticResource VHair}"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock FontWeight="Bold" FontSize="{s:Fs 20}" Foreground="{DynamicResource TealDeepBrush}" HorizontalAlignment="Center">
                                    <Run Text="+"/><Run Text="{Binding Referral.TotalBonusDays, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{loc:T 'Бонус дней'}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="2" Style="{StaticResource Hair}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="3" Text="{loc:T 'У вас пока нет приглашённых пользователей'}" FontWeight="Medium" FontSize="{s:Fs 12}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7" TextWrapping="Wrap"
                                   Visibility="{Binding Referral.HasEntries, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <controls:PagedItems Grid.Row="4" ItemsSource="{Binding Referral.Entries}">
                            <controls:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="2" Background="{DynamicResource ChipBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BonusLabel}" FontWeight="Bold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TealDeepBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="{Binding HasBonusLabel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Статус: активен — TealTint + сплошная обводка Teal + точка; иначе — пунктир. -->
                                        <Grid Grid.Column="3" Height="22" VerticalAlignment="Center">
                                            <Rectangle x:Name="StatusFrame" RadiusX="11" RadiusY="11" StrokeThickness="1"
                                                       Stroke="{DynamicResource TextSecondaryBrush}" StrokeDashArray="3 3" Fill="Transparent"/>
                                            <StackPanel Orientation="Horizontal" Margin="7,0,9,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="Transparent" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StatusText" Text="{Binding StatusBadge}" FontWeight="ExtraBold" FontSize="{s:Fs 10}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="StatusFrame" Property="Stroke" Value="{DynamicResource TealBrush}"/>
                                            <Setter TargetName="StatusFrame" Property="StrokeDashArray" Value="{x:Null}"/>
                                            <Setter TargetName="StatusFrame" Property="Fill" Value="{DynamicResource TealTintBrush}"/>
                                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TealBrush}"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </controls:PagedItems.ItemTemplate>
                        </controls:PagedItems>
                    </Grid>
                </controls:GlassPanel>
            </Grid>

            <Grid Visibility="{Binding IsNewsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:T 'Новостей пока нет.'}" FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <!-- Компактные строки вместо крупных карточек (1.0.132): одна карточка со
                     строками «заголовок + дата»; полный текст и кнопки раскрываются под строкой.
                     «Ещё» — постраничность PagedItems (‹ 1 / 3 ›) и «Читать полностью» в тексте. -->
                <controls:GlassPanel Style="{StaticResource GlassCard}" VerticalAlignment="Top"
                                     Visibility="{Binding HasNews, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:PagedItems ItemsSource="{Binding AllNews}">
                        <controls:PagedItems.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle Style="{StaticResource PagedSep}"/>
                                    <Button Style="{StaticResource RowButton}" Padding="14,11"
                                            Command="{Binding ToggleExpandedCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="{s:Fs 10}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" x:Name="Chev" Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}"
                                                  Width="15" Height="15" Fill="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="Body" Visibility="Collapsed" Margin="14,0,14,12">
                                        <controls:RichTextView Document="{Binding Document}" Focusable="False" Margin="0,4,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,7,0,0"
                                                      Visibility="{Binding Buttons.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ChipButton}" Height="32" Margin="0,0,6,6" Content="{Binding Text}"
                                                            Command="{Binding DataContext.OpenBroadcastButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Url}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                        <!-- Раскрыто — шеврон «вниз» (иконки вниз нет, геометрия expand_more). -->
                                        <Setter TargetName="Chev" Property="Data" Value="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </controls:PagedItems.ItemTemplate>
                    </controls:PagedItems>
                </controls:GlassPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
