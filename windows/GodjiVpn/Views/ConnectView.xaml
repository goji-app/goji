<UserControl x:Class="GodjiVpn.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Главная — десктопный макет 9a: слева панель с заливкой по состоянию (метка, код страны, заголовок,
         подзаголовок), справа колонка 320 с таблицей и кнопкой ‹ ОТКЛЮЧИТЬ ›. Кисти Home* перекрашивает
         code-behind плавно за 500 мс. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="HomeFillBrush" Color="#F4F5F2"/>
        <SolidColorBrush x:Key="HomeInkBrush" Color="#2A3430"/>
        <SolidColorBrush x:Key="HomeMutBrush" Color="#5F6A65"/>
        <SolidColorBrush x:Key="HomeBtnBrush" Color="#4F6358"/>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{s:Fs 13}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
        <!-- Плоская кнопка: угол 2, моно капс. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.92"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стрелки ‹ › 56×56 с рамкой. -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{s:Fs 22}" Foreground="{DynamicResource InkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InkBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с заливкой состояния -->
        <Grid Grid.Column="0" Background="{DynamicResource HomeFillBrush}">
            <StackPanel Margin="28,26,28,0">
                <Grid>
                    <TextBlock FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 11}" Foreground="{DynamicResource HomeMutBrush}" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:T 'НЕТ ЗАЩИТЫ'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Text" Value="{loc:T 'ПОДКЛЮЧЕНИЕ'}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="{loc:T 'В ТУННЕЛЕ'}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 11}" Foreground="{DynamicResource HomeMutBrush}"
                               Text="{Binding ServerCounter}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Код страны 170: контур в выключенном состоянии, заливка — при подключении и в сети. Тап — следующая страна. -->
                <controls:CountryCodeText Margin="-6,10,0,0" Text="{Binding CountryCode}" MaxFontSize="170" Decor="True" Cursor="Hand"
                                          Stroke="{DynamicResource OutlineVariantBrush}" ToolTip="{loc:T 'Следующая страна'}"
                                          AutomationProperties.Name="{Binding CountryCode}">
                    <controls:CountryCodeText.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NextServerCommand}"/>
                    </controls:CountryCodeText.InputBindings>
                    <controls:CountryCodeText.Style>
                        <Style TargetType="controls:CountryCodeText">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource HomeInkBrush}"/>
                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource HomeInkBrush}"/>
                                    <Setter Property="Stroke" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:CountryCodeText.Style>
                </controls:CountryCodeText>

                <!-- Заголовок со снегом на буквах (вне сезона рисуется как обычный текст) -->
                <controls:SnowText Text="{Binding Headline}" FontWeight="SemiBold" FontSize="{s:Fs 32}" Foreground="{DynamicResource HomeInkBrush}"
                                   Margin="0,14,0,0" AutomationProperties.Name="{Binding Headline}"/>
                <TextBlock Text="{Binding Subline}" FontSize="{s:Fs 15}" Foreground="{DynamicResource HomeMutBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- Ошибка подключения: заметный блок — красная полоса слева, подложка ошибки, кнопки действий -->
                <Border Margin="0,18,0,0" Padding="14,12,14,14" BorderThickness="4,0,0,0" BorderBrush="{DynamicResource DangerBrush}"
                        Background="{DynamicResource ErrorContainerBrush}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'ОШИБКА'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 11}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorHint}" FontWeight="Bold" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ErrorHint, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="{s:Fs 13}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding RetryRefreshCommand}" Style="{StaticResource FlatButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                    Background="{DynamicResource DangerBrush}" Visibility="{Binding CanRetryRefresh, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:T 'ПОВТОРИТЬ'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 12}" Foreground="{DynamicResource SurfaceBrush}"/>
                            </Button>
                            <Button Command="{Binding OpenServersCommand}" Style="{StaticResource FlatButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                    Background="{DynamicResource DangerBrush}" Visibility="{Binding CanChangeServer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:T 'СМЕНИТЬ СЕРВЕР'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 12}" Foreground="{DynamicResource SurfaceBrush}"/>
                            </Button>
                            <Button Command="{Binding OpenTrafficCommand}" Style="{StaticResource FlatButton}" Height="36" Padding="14,0"
                                    Background="{DynamicResource DangerBrush}" Visibility="{Binding CanOpenPlans, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:T 'ОТКРЫТЬ ПОДПИСКУ'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 12}" Foreground="{DynamicResource SurfaceBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Пробный период — включается прямо в приложении -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasTrial, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding TrialTitle}" FontWeight="SemiBold" FontSize="{s:Fs 15}" Foreground="{DynamicResource HomeInkBrush}" TextWrapping="Wrap"/>
                    <Button Content="{loc:T 'ВКЛЮЧИТЬ ПРОБНЫЙ ПЕРИОД'}" Command="{Binding ActivateTrialCommand}" Height="40" HorizontalAlignment="Left" Padding="16,0" Margin="0,8,0,0"
                            Foreground="{DynamicResource InkBtnTextBrush}" Background="{DynamicResource HomeBtnBrush}"
                            FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 12}" Style="{StaticResource FlatButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding TrialNotice}" FontSize="{s:Fs 12}" Foreground="{DynamicResource HomeMutBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding TrialNotice, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Правая колонка 320: таблица и управление -->
        <Grid Grid.Column="1" Background="{DynamicResource BgSolidBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="28,26,28,0">
                <Border Style="{StaticResource TableRow}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Mono}" Text="{loc:T 'УЗЕЛ'}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoValue}" Text="{Binding NodeCity}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TableRow}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Mono}" Text="{loc:T 'В СЕТИ'}"/>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                    <Setter Property="Text" Value="—"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="{Binding ConnectedTimeLabel}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TableRow}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Mono}" Text="{loc:T 'ПОДПИСКА'}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoValue}" Text="{Binding SubDaysLabel}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TableRow}" BorderThickness="0,1,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Mono}" Text="{loc:T 'ПИНГ'}"/>
                        <controls:PingBar Grid.Column="1" Width="80" PingMs="{Binding PingMs}" MarkerBrush="{DynamicResource InkBrush}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource MonoValue}" Text="{Binding PingText}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TableRow}" BorderThickness="0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Mono}" Text="{loc:T 'СКОРОСТЬ'}"/>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
                                    <Setter Property="Text" Value="—"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="↓ {0}  ↑ {1}{2}">
                                                        <Binding Path="DownSpeedLabel"/><Binding Path="UpSpeedLabel"/><Binding Path="SpeedUnit"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ‹ ОТКЛЮЧИТЬ › — смена страны стрелками, кнопка посередине -->
            <Grid Grid.Row="2" Margin="28,0,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ArrowButton}" Content="‹" Command="{Binding PrevServerCommand}" AutomationProperties.Name="{loc:T 'Предыдущая страна'}"/>
                <Button Grid.Column="1" Margin="8,0" Command="{Binding ToggleCommand}" Style="{StaticResource FlatButton}"
                        Background="{DynamicResource HomeBtnBrush}" AutomationProperties.Name="{loc:T 'Подключение'}" ToolTip="Ctrl+Shift+G">
                    <TextBlock FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 14}"
                               Foreground="{DynamicResource InkBtnTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:T 'ВКЛЮЧИТЬ'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Text" Value="{loc:T 'ОТМЕНА'}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="{loc:T 'ОТКЛЮЧИТЬ'}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ArrowButton}" Content="›" Command="{Binding NextServerCommand}" AutomationProperties.Name="{loc:T 'Следующая страна'}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
