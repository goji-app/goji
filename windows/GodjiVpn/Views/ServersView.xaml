<UserControl x:Class="GodjiVpn.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls"
             xmlns:vm="clr-namespace:GodjiVpn.ViewModels">
    <!-- Серверы v5 «Стекло» — по эталону screens/*-servers.png и ServersScreen.kt: колонка
         padding 16, gap 12; все узлы — ОДНА карточка со строками через Hair. -->
    <!-- Без прокрутки: список узлов занимает оставшееся место и листается страницами. -->
    <Grid Margin="16" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:T 'Где выйти в сеть'}" Style="{StaticResource ScreenTitle}" TextWrapping="Wrap"/>
                    <TextBlock FontWeight="Medium" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0">
                        <Run Text="{Binding Nodes.Count, Mode=OneWay}"/><Run Text="{loc:T ' узлов в подписке'}"/>
                    </TextBlock>
                </StackPanel>
                <!-- Две кнопки, у каждой свой индикатор (2026-10-28): с одной общей он крутился и во
                     время автоматической проверки пинга — выглядело как «постоянное обновление». -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Style="{StaticResource BareButton}" Command="{Binding PingAllCommand}" AutomationProperties.Name="{loc:T 'Проверить пинг всех серверов'}">
                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="2" Height="40" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBolt}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TealDeepBrush}"
                                          Visibility="{Binding IsCheckingAll, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <controls:Spinner Foreground="{DynamicResource TealDeepBrush}"
                                                      Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{loc:T 'Пинг'}" FontWeight="Bold" FontSize="{s:Fs 13}" Foreground="{DynamicResource TealDeepBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource BareButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" AutomationProperties.Name="{loc:T 'Обновить список серверов'}">
                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="2" Height="40" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TealDeepBrush}"
                                          Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <controls:Spinner Foreground="{DynamicResource TealDeepBrush}"
                                                      Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{loc:T 'Обновить'}" FontWeight="Bold" FontSize="{s:Fs 13}" Foreground="{DynamicResource TealDeepBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Сортировка (Android 64aa106): тот же сегмент-контрол, что "Язык" в Настройках, ниже — 32. -->
            <controls:SegmentedControl Grid.Row="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"
                                       ItemHeight="32" LabelFontSize="12" Margin="0,12,0,0"/>

            <!-- Баннер-результат ручного "Обновить": круг 24 с галочкой/!, текст 12, крестик 22. -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10,8,10" BorderThickness="4,0,0,0"
                    Visibility="{Binding RefreshResultMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BannerOkBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RefreshResultIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ErrorContainerBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RefreshResultMessage}" FontWeight="SemiBold" FontSize="{s:Fs 13}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="1" Style="{StaticResource BareButton}" Command="{Binding DismissRefreshResultCommand}" VerticalAlignment="Center" Padding="8,6"
                            AutomationProperties.Name="{loc:T 'Закрыть'}">
                        <TextBlock Text="×" FontWeight="Bold" FontSize="{s:Fs 16}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Все узлы — одна карточка. -->
            <controls:PagedItems Grid.Row="3" Columns="2" Margin="0,12,0,0" VerticalAlignment="Top" ItemsSource="{Binding Nodes}">
                <controls:PagedItems.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeItem}">
                        <!-- Ячейка макета 9a: код страны 34 моно, название, шкала пинга; выбранная — «шалфей». -->
                        <Border x:Name="Cell" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource OutlineVariantBrush}"
                                Margin="0,0,12,0" Background="Transparent">
                            <Grid>
                                <Button Style="{StaticResource BareButton}" controls:Press.Scale="1" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="14,12,44,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Code}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 34}"
                                                   Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{s:Fs 15}" Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <controls:PingBar Width="56" BarHeight="4" PingMs="{Binding PingBarMs}" MarkerBrush="{DynamicResource InkBrush}"/>
                                                <TextBlock Text="{Binding PingNumber}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="SemiBold" FontSize="{s:Fs 12}"
                                                           Foreground="{DynamicResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,4,2,0">
                                    <Button Style="{StaticResource BareButton}" Padding="6" AutomationProperties.Name="{loc:T 'Проверить пинг'}"
                                            Command="{Binding DataContext.PingOneCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconBolt}" Style="{StaticResource Icon}" Width="13" Height="13" Fill="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource BareButton}" Padding="6" AutomationProperties.Name="{loc:T 'Избранное'}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}">
                                        <Path x:Name="Star" Data="{StaticResource IconStarOutline}" Style="{StaticResource Icon}" Width="14" Height="14"
                                              Fill="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                                <!-- Узел, добавленный вручную по JSON — только у таких есть удаление. -->
                                <Button Style="{StaticResource BareButton}" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,4"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.RemoveCustomNodeCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                        CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconDelete}" Style="{StaticResource Icon}" Width="13" Height="13" Fill="{DynamicResource DangerBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Star" Property="Data" Value="{StaticResource IconStar}"/>
                                <Setter TargetName="Star" Property="Fill" Value="{DynamicResource InkBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </controls:PagedItems.ItemTemplate>
            </controls:PagedItems>

    </Grid>
</UserControl>
