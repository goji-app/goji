<UserControl x:Class="GodjiVpn.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <UserControl.Resources>
        <!-- Пункт левой навигации макета 9a: «01 ГЛАВНАЯ», моно 12; активный — рамка слева 3 и фон surface. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Height="44">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 12}"
                                       VerticalAlignment="Center" Margin="22,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgSolidBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая навигация 188 -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource OutlineVariantBrush}">
            <StackPanel Margin="0,28,0,0">
                <TextBlock Text="GOJI" FontFamily="{StaticResource JetBrainsMonoFamily}" FontWeight="Bold" FontSize="{s:Fs 13}"
                           Foreground="{DynamicResource InkBrush}" Margin="25,0,0,26"/>
                <RadioButton Style="{StaticResource NavItem}" Content="{loc:T '01 ГЛАВНАЯ'}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="{loc:T '02 СЕРВЕРЫ'}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="{loc:T '03 АККАУНТ'}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                <RadioButton Style="{StaticResource NavItem}" Content="{loc:T '04 НАСТРОЙКИ'}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"/>
            </StackPanel>
        </Border>

        <!-- Содержимое: без прокрутки, длинные списки — постранично -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Connect}"
                            Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}"/>
            <ContentControl Content="{Binding Servers}"
                            Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}"/>
            <ContentControl Content="{Binding Plans}"
                            Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}"/>
            <ContentControl Content="{Binding Settings}"
                            Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}"/>
        </Grid>
    </Grid>
</UserControl>
