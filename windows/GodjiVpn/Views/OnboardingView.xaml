<UserControl x:Class="GodjiVpn.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Знакомство — макет 9a: «Пропустить», панель «шалфей» с огромным кодом, заголовок, текст, три сегмента и кнопка. -->
    <UserControl.Resources>
        <!-- Поле только с нижней линией (макет 9a «Вход») -->
        <Style x:Key="LineBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{s:Fs 18}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource InkBrush}" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Плоская кнопка 56: моно капс, угол 2 -->
        <Style x:Key="FlatCta" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{s:Fs 14}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.92"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgSolidBrush}">
        <Grid Width="460" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Style="{StaticResource BareButton}" Command="{Binding SkipCommand}" HorizontalAlignment="Right" Padding="0,8"
                    Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="{loc:T 'Пропустить'}" FontSize="{s:Fs 14}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
            <Border Grid.Row="1" Height="180" Background="{DynamicResource SecondaryContainerBrush}" Margin="0,6,0,0">
                <StackPanel VerticalAlignment="Center">
                    <controls:CountryCodeText Text="{Binding Code}" MaxFontSize="100" Centered="True" Fill="{DynamicResource OnSecondaryContainerBrush}"/>
                    <TextBlock Text="{Binding CodeCaption}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 11}" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource OnSecondaryContainerBrush}" Margin="16,12,16,0"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding Current.Title}" FontWeight="SemiBold" FontSize="{s:Fs 30}" TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}" Margin="0,22,0,0"/>
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Current.Points}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="4" Margin="0,22,0,0">
                <ItemsControl ItemsSource="{Binding Dots}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="2" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource OutlineVariantBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="True"><Setter Property="Background" Value="{DynamicResource InkBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource FlatCta}" Margin="0,16,0,0" Content="{Binding NextLabelUpper}" Command="{Binding NextCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
