<UserControl x:Class="GodjiVpn.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GodjiVpn.Controls"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Вход — макет 9a: «Войти по почте», поле с нижней линией, кнопка «ПОЛУЧИТЬ КОД»; следующий шаг —
         «Код из письма» (6 клеток). Без глобуса; колонка 420 по центру окна. -->
    <UserControl.Resources>
        <!-- Поле только с нижней линией (макет 9a «Вход») -->
        <Style x:Key="LineBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{s:Fs 18}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource InkBrush}" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Плоская кнопка 56: моно капс, угол 2 -->
        <Style x:Key="FlatCta" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InkBtnBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFamily}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{s:Fs 14}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.92"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgSolidBrush}">
        <!-- Шаг 1: почта -->
        <StackPanel Width="420" VerticalAlignment="Center" Visibility="{Binding OtpSent, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <loc:LangPicker Margin="0,0,0,18"/>
            <!-- Зимой — шапка Деда Мороза на «В» заголовка (вне сезона элемент схлопывается) -->
            <controls:SantaHat HorizontalAlignment="Left" Margin="2,0,0,0" HatWidth="58"/>
            <TextBlock Text="{loc:T 'Войти по почте'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="{loc:T 'Пришлём код из шести цифр. Пароль не нужен. Первые 3 дня бесплатно.'}" FontSize="{s:Fs 15}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="{loc:T 'ПОЧТА'}" FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 11}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,30,0,8"/>
            <TextBox Style="{StaticResource LineBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T 'Почта'}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{s:Fs 12}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            <Button Style="{StaticResource FlatCta}" Margin="0,28,0,0" Content="{loc:T 'ПОЛУЧИТЬ КОД'}" Command="{Binding SendOtpCommand}" IsDefault="True"/>
            <TextBlock TextWrapping="Wrap" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,0">
                <Run Text="{loc:T 'Аккаунта нет? Создадим сами, ничего заполнять не нужно. Создавая аккаунт, вы соглашаетесь с '}"/>
                <Hyperlink Foreground="{DynamicResource InkBrush}" TextDecorations="{x:Null}" Click="OnTermsClick"><Run Text="{loc:T 'пользовательским соглашением'}" FontWeight="SemiBold"/></Hyperlink>
                <Run Text="{loc:T ' и '}"/>
                <Hyperlink Foreground="{DynamicResource InkBrush}" TextDecorations="{x:Null}" Click="OnPrivacyClick"><Run Text="{loc:T 'политикой конфиденциальности'}" FontWeight="SemiBold"/></Hyperlink>
                <Run Text="."/>
            </TextBlock>
        </StackPanel>

        <!-- Шаг 2: код из письма -->
        <StackPanel Width="420" VerticalAlignment="Center" Visibility="{Binding OtpSent, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Visibility="{Binding IsVerifySuccess, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Button Style="{StaticResource BareButton}" Command="{Binding ChangeEmailCommand}" HorizontalAlignment="Left" Padding="0,6,12,6" AutomationProperties.Name="{loc:T 'Назад'}">
                    <TextBlock Text="‹ ПОЧТА" FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{loc:T 'Код из письма'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}" Margin="0,14,0,0"/>
                <TextBlock FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
                    <Run Text="{loc:T 'Отправили на '}"/><Run Text="{Binding Email, Mode=OneWay}"/><Run Text="{loc:T '. Письмо идёт до минуты — загляни в «Спам».'}"/>
                </TextBlock>
                <controls:OtpInput x:Name="Otp" Code="{Binding Code, Mode=TwoWay}" Margin="-4,30,-4,0"
                                   HasError="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"/>
                <TextBlock FontFamily="{StaticResource JetBrainsMonoFamily}" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:T 'ПРОВЕРКА ЗАПУСТИТСЯ САМА'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="{loc:T 'ПРОВЕРЯЕМ…'}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{s:Fs 12}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button Style="{StaticResource FlatCta}" Margin="0,24,0,0" Content="{loc:T 'ВОЙТИ'}" Command="{Binding VerifyCommand}" IsDefault="True"/>
            </StackPanel>
            <StackPanel Visibility="{Binding IsVerifySuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{loc:T 'Готово'}" FontWeight="SemiBold" FontSize="{s:Fs 30}" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="{loc:T 'Почта подтверждена'}" FontSize="{s:Fs 15}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
